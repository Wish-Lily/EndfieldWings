Mods: {
	EndfieldWings: {
		Items: {
			SiWings: {
				DisplayName: 祀岁翼
				Tooltip: '''
					无限飞行
					空中连按两次跳跃：切换巡航 / 悬浮模式
					巡航：长按跳跃持续上升，按住跳跃 + ↓ 悬停
					悬浮：默认悬停，方向键即时变向
					装备后右下角出现权能轮盘
					「川绣春江，山锁秋暝，故梦更尽万物新」
					'''
			}
			ZiWuSword: {
				DisplayName: 子武剑
				Tooltip: '''
					攻击 20% 概率无视防御
					十二刻印之一 · 子时
					「敬刻一道破勇力，入时者畏惧退避」
					'''
			}
			WuShangShuttle: {
				DisplayName: 午商梭
				Tooltip: '''
					免疫摔落、岩浆、溺水伤害
					NPC 处购买价格减半
					十二刻印之一 · 午时
					「敬刻七长绢聚富，入时者不知财数」
					'''
			}
			WeiJianRuler: {
				DisplayName: 未建尺
				Tooltip: '''
					自身伤害同时视为近战伤害和魔法伤害
					十二刻印之一 · 未时
					「敬刻八筑巧藏珍，入时者流连难返」
					'''
			}
			ShenZhuWheel: {
				DisplayName: 申铸轮
				Tooltip: '''
					佩戴时视为同时处于所有制造环境
					十二刻印之一 · 申时
					「敬刻九铸金熔火，入时者得见其妙」
					'''
			}
			HaiShiStove: {
				DisplayName: 亥食灶
				Tooltip: '''
					每秒恢复自身 0.5% 最大生命值
					十二刻印之一 · 亥时
					「敬刻十二催饭香，入时者亲属饱肚肠」
					'''
			}
			YinShiPot: {
				DisplayName: 寅诗壶
				Tooltip: '''
